# ===========================================================================
# CLOUD variant — MinInfer served to other people.
#
# The credentials below are PLACEHOLDERS for validation only
# (`scripts/validate-phase0.sh` boots with this file). They are deliberately
# obvious so that shipping this profile unchanged is a visible mistake. Real
# keys belong in the platform's secret store — Fly secrets, AWS Secrets
# Manager, a Kubernetes Secret — injected as environment variables, never
# committed here.
#
#   fly secrets set MI_API_KEYS_FILE=/run/secrets/mininfer-keys.json
#   fly secrets set MI_ADMIN_TOKEN=...
#
# What differs from `local.env`, and why each one matters:
#   * access control is ON — everything except /healthz and /assets is guarded;
#   * limits are ON — an exposed proxy spends money on /v1/search;
#   * state moves to a mounted volume (and, from Phase 1, to Postgres, because
#     every request writes and SQLite is single-writer);
#   * a body cap replaces "whatever the client sends".
# ===========================================================================

HOST=0.0.0.0
PORT=8000

# State: a mounted volume, not the image. `/app/seed.db` in the Dockerfile is a
# starting registry, not the live one.
#
# Swap the two lines below to move the registry to Postgres. This is the Phase 1
# step that lifts the single-replica limit: every request writes (a decision, plus
# an observation per attempt) and SQLite is single-writer, so replicas > 1 only
# become safe once the registry is shared.
#
#   MI_DB=mininfer.db                    # SQLite: one replica
MI_DB=postgresql://mininfer:REPLACE_ME@db.internal:5432/mininfer
MI_POLICY=/app/config/policy.yaml

# Shared counters and caches. Without it each replica counts on its own, so
# "120 rpm" becomes "120 rpm per replica" — a limit that silently loosens as you
# scale. It also backs the benchmark-norms cache (mininfer/cache.py), so every
# replica reads one cached band instead of rescanning. Needs `pip install redis`
# (the deploy image includes it).
MI_REDIS_URL=redis://redis.internal:6379/0

# --- access control: the whole point of this profile ------------------------
# Prefer MI_API_KEYS_FILE (SHA-256 digests, so the file holds no usable
# credential) over MI_API_KEYS (plaintext in the environment). Set one.
MI_API_KEYS=sk-validation-only-do-not-deploy:validation
MI_API_KEYS_FILE=
MI_ADMIN_TOKEN=validation-admin-do-not-deploy

# Requests/minute per tenant. The counter lives in Redis when MI_REDIS_URL is
# set, so this is exact across replicas; without it the limit is per-process.
MI_RATE_LIMIT_RPM=120

# 1 MiB. A chat request is a few KiB; anything far larger is a mistake or an
# attack, and either way it should not reach the router.
MI_MAX_BODY_BYTES=1048576

# Leave empty when every client is same-origin (the SPA is served from here).
# Set it only for browser clients on another origin.
MI_CORS_ORIGINS=
