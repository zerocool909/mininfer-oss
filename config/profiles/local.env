# ===========================================================================
# LOCAL variant — MinInfer as a single-process tool on your own machine.
#
# Nothing here enables access control. The dashboard, the API and the docs are
# open, there is no rate limit, and the registry is a SQLite file next to the
# code. That is the point: this is the developer experience MinInfer shipped
# with, and `tests/test_profiles.py` pins it so a cloud-hardening change can
# never quietly lock local development out.
#
#   mi proxy                 # http://127.0.0.1:8765
#   docker compose up        # the same thing in a container
# ===========================================================================

HOST=127.0.0.1
PORT=8765

# State: a file beside the code, plus the raw evidence lake.
MI_DB=mininfer.db
MI_POLICY=config/policy.yaml

# No shared counters: one process, so an in-process limiter is exact. Stated
# explicitly (empty) so the two profiles declare the same knob set and neither
# inherits whatever the shell happened to export.
MI_REDIS_URL=

# Access control: deliberately OFF. Do not add keys to this profile — put them
# in config/profiles/cloud.env instead.
MI_API_KEYS=
MI_API_KEYS_FILE=
MI_ADMIN_TOKEN=
MI_RATE_LIMIT_RPM=0
MI_MAX_BODY_BYTES=0
MI_CORS_ORIGINS=
