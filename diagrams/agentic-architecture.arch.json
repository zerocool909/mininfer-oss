    {
      "dot": "cyan",
      "title": "Touch Points — Runtime",
      "items": [
        "Two LangGraph graphs: ingest (7 nodes), resolve (3)",
        "resolve_endpoint is the only path to a model",
        "resolve imports _agent_llm from the ingest agent"
      ]
    },
    {
      "dot": "emerald",
      "title": "Touch Points — State",
      "items": [
        "SQLite mininfer.db: weights, deployments, evidence",
        "fetch_raw writes raw/ before any parsing",
        "make_deploy and validate_prices guard each row"
      ]
    },
    {
      "dot": "amber",
      "title": "Unknowns Kept Unknown",
      "items": [
        "Unreported capability stays None, never coerced",
        "A >20% price disagreement is quarantined",
        "merge_weights re-checks size, records refusals"
      ]
    }
