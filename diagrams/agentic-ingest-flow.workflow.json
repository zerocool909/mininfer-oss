{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Agentic Ingestion Flow — LangGraph Agent + Deterministic Guard",
    "output": "diagrams/agentic-ingest-flow.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "extraction-path",
        "label": "Extraction path",
        "focus": [
          "request",
          "fetch",
          "extract",
          "llm",
          "normalize"
        ],
        "note": "A webpage becomes candidate facts: fetch, parse, LLM-extract, normalize."
      },
      {
        "id": "guard-path",
        "label": "Guard and outcome",
        "focus": [
          "normalize",
          "validate",
          "commit",
          "raw"
        ],
        "note": "Accepted facts commit to the registry; the guard is deterministic, not the model."
      },
      {
        "id": "quarantine-path",
        "label": "Held, not merged",
        "focus": [
          "validate",
          "quarantine",
          "raw"
        ],
        "note": "A claim that disagrees with the registry is quarantined, never merged."
      }
    ]
  },
  "lanes": [
    {
      "id": "agent",
      "label": "Agent Runtime"
    },
    {
      "id": "store",
      "label": "Registry & Evidence"
    },
    {
      "id": "exception",
      "label": "Quarantine",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "intake",
      "label": "Fetch + parse",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "reason",
      "label": "LLM extraction",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "decide",
      "label": "Normalize + guard",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "graph_state",
      "label": "LangGraph state, per URL",
      "lane": "agent",
      "fromCol": 1,
      "toCol": 4
    },
    {
      "id": "guard_group",
      "label": "Validator, not a trust",
      "lane": "agent",
      "fromCol": 5,
      "toCol": 5,
      "variant": "security"
    },
    {
      "id": "hold_group",
      "label": "Held on disagreement",
      "lane": "exception",
      "fromCol": 3,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "mainPath": [
    "request",
    "fetch",
    "extract",
    "llm",
    "normalize",
    "validate",
    "commit"
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "agent",
      "col": 0,
      "type": "external",
      "label": "mi add-url",
      "sublabel": "arbitrary webpage",
      "tag": "non-JSON only",
      "width": 132
    },
    {
      "id": "fetch",
      "lane": "agent",
      "col": 1,
      "type": "backend",
      "label": "fetch_raw",
      "sublabel": "ttl-cached pull",
      "tag": "errors recorded",
      "width": 132
    },
    {
      "id": "extract",
      "lane": "agent",
      "col": 2,
      "type": "backend",
      "label": "extract",
      "sublabel": "JSON or HTML text",
      "tag": "12k chars · 30 tables",
      "width": 132
    },
    {
      "id": "llm",
      "lane": "agent",
      "col": 3,
      "type": "backend",
      "label": "LLM extract",
      "sublabel": "ChatOpenAI · temp 0",
      "tag": "agent model via router",
      "width": 132
    },
    {
      "id": "normalize",
      "lane": "agent",
      "col": 4,
      "type": "backend",
      "label": "normalize",
      "sublabel": "three-valued facts",
      "tag": "None stays unknown",
      "width": 132
    },
    {
      "id": "validate",
      "lane": "agent",
      "col": 5,
      "type": "security",
      "label": "Cross-check",
      "sublabel": "price vs provider API",
      "tag": "±20% → reject",
      "width": 132
    },
    {
      "id": "raw",
      "lane": "store",
      "col": 1,
      "type": "database",
      "label": "Evidence Lake",
      "sublabel": "snapshot before parse",
      "tag": "raw/ sha256",
      "width": 132
    },
    {
      "id": "commit",
      "lane": "store",
      "col": 5,
      "type": "database",
      "label": "Commit",
      "sublabel": "upsert weights + deploy",
      "tag": "evidence 0.4",
      "width": 132
    },
    {
      "id": "quarantine",
      "lane": "exception",
      "col": 5,
      "type": "security",
      "label": "Quarantine",
      "sublabel": "disagreement held",
      "tag": "never merged",
      "width": 132
    }
  ],
  "edges": [
    {
      "id": "request-fetch",
      "from": "request",
      "to": "fetch",
      "label": "URL",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "fetch-snapshot",
      "from": "fetch",
      "to": "raw",
      "label": "snapshot",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "fetch-extract",
      "from": "fetch",
      "to": "extract",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "extract-llm",
      "from": "extract",
      "to": "llm",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "llm-normalize",
      "from": "llm",
      "to": "normalize",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "normalize-validate",
      "from": "normalize",
      "to": "validate",
      "label": "candidates",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "validate-commit",
      "from": "validate",
      "to": "commit",
      "label": "accepted",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "validate-quarantine",
      "from": "validate",
      "to": "quarantine",
      "label": "disagreement",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Agentic, Not Autonomous",
      "items": [
        "The LLM extracts facts; a deterministic validator decides",
        "Every fact is evidence at confidence 0.4, not a measurement",
        "The model widens consideration; it cannot override the check"
      ]
    },
    {
      "dot": "rose",
      "title": "Held, Never Merged",
      "items": [
        "Price off by >20% versus the provider API is quarantined",
        "A page claiming free against a paid row is quarantined",
        "Fetch and LLM failures are recorded; the run does not crash"
      ]
    },
    {
      "dot": "violet",
      "title": "Second Agent — Resolver",
      "items": [
        "mi/agent_resolve.py reviews near-match weight pairs",
        "Quantization variants match; a different size does not",
        "merge_weights re-checks size and records each refusal"
      ]
    }
  ]
}
