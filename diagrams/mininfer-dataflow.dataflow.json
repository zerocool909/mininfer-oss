  "cards": [
    {
      "dot": "cyan",
      "title": "Build — Operator Runs a Command",
      "items": [
        "mi ingest pulls every source and snapshots it to raw/ before parsing",
        "mi resolve merges the same model across sources; a near match is proposed, never merged",
        "mi add-url runs the LangGraph agent over an arbitrary page; every fact is evidence at 0.4"
      ]
    },
    {
      "dot": "emerald",
      "title": "Answer — One Request, End to End",
      "items": [
        "mi proxy serves POST /v1/chat/completions; model \"auto\" routes the default task",
        "The router reads the registry, hard-filters for capability and price, then ranks by cost-per-success",
        "Tokens stream back as SSE and the call is appended as an observation, success or failure"
      ]
    },
    {
      "dot": "amber",
      "title": "Read + What Stays Unknown",
      "items": [
        "mi sync mirrors keyed rows to Supabase; /v1/stats and / serve the dashboard read-only",
        "Capability is three-valued: unreported stays None and is never coerced to False",
        "Vendor ownership is inferred from the model namespace; unknown when there is none"
      ]
    }
  ]
