# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
# Supabase Postgres connection string:
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Use the POOLER host. Newer Supabase projects expose the direct
# `db.<ref>.supabase.co` host over IPv6 only, which fails on many networks.
#   Session pooler:     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction pooler: ...pooler.supabase.com:6543/postgres   (fine for `mi sync`)
SUPABASE_DB_URL=

# Optional. The publishable/anon key is NOT needed for `mi sync` (that uses the
# Postgres URI above); it is only for REST/RLS dashboard access.
SUPABASE_URL=https://mkoieqyapttbutixkbub.supabase.co
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Provider keys. Any provider in `mi/execute.py:ENDPOINTS` enables itself when
# its key is present here — the router can then actually call that provider.
#
# Vercel AI Gateway (used by `vercel:*` deployments):
#   Vercel dashboard -> AI Gateway -> API Keys -> create key
AI_GATEWAY_API_KEY=

# Web search providers (`mi search` / the scout's form guide). Auto walks the
# free tiers first: wikipedia -> duckduckgo -> tinyfish -> tavily (paid fallback).
# TinyFish: free up to 12,000 requests/day (resets 00:00 UTC); key from
# https://agent.tinyfish.ai/api-keys
# TINYFISH_API_KEY=
# TAVILY_API_KEY=

# The "birthright" search quota. When set, each tenant gets this many free
# searches per UTC day; the next one is refused with 429 search_daily_quota_exceeded
# (the response also carries search_quota.remaining_today). 0 or unset = unlimited.
# MI_SEARCH_DAILY_LIMIT=100
# Set to 0 to forbid the paid Tavily fallback entirely: `auto` then stops at the
# free tiers, so an empty free tier is an empty result rather than a $0.008 bill.
# MI_SEARCH_ALLOW_PAID=0

# Which provider the scout (`mi scout`) uses to research a model's current
# details. TinyFish only by default: structured JSON with URLs is the most
# reliable evidence for agent research, and the scout prefers an ungrounded
# dossier over a thinly-sourced one. With no TINYFISH_API_KEY the search is
# skipped (registry facts only), never swapped for a different tier.
# MI_SCOUT_SEARCH_PROVIDER=tinyfish

# The voice for each dossier's `warrior`/`story` (the storied half shown on the
# Free models tab). epic (default) = heroic warrior framing; plain = no metaphor;
# deadpool = irreverent, fourth-wall-breaking quips. The factual fields
# (core_competency, summary, when_to_use) stay dry regardless.
# MI_SCOUT_TONE=epic

# Chat web search. off (default) = chat never searches. auto = search only when
# the prompt trips a time-sensitivity/explicit cue ("latest", "today", "look it
# up", a URL, a year). on = every chat turn is grounded. A request can override
# either way with a `"search": true|false` field. Grounded results are injected
# as a system message, so the routed model answers from supplied evidence.
# MI_CHAT_SEARCH=auto
# Which provider grounds the chat. TinyFish by default (fresh, structured), because
# `auto` stops at the first non-empty answer and Wikipedia returns tangential
# encyclopedia pages for news queries. Without a TINYFISH_API_KEY it falls back to
# the keyless tiers (wikipedia -> duckduckgo).
# MI_CHAT_SEARCH_PROVIDER=tinyfish

# Other examples (see `mi sources` for the full list):
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=

# ---------------------------------------------------------------------------
# Serving MinInfer to other people (all optional — leave unset for local dev).
#
# With none of these set, the proxy is exactly the local tool it has always
# been: no auth, no rate limiting, open dashboard. Setting any of them turns on
# access control.

# Earliest form: `key:tenant,key2:tenant2`. Fine for a container secret; prefer
# MI_API_KEYS_FILE for anything checked in.
# MI_API_KEYS=sk-live-abc123:acme

# JSON list of {"tenant", "key_sha256", "rpm"?}. Keys are compared as SHA-256
# digests, so the file never holds a usable credential:
#   [{"tenant": "acme", "key_sha256": "<sha256 of the key>", "rpm": 120}]
# MI_API_KEYS_FILE=/run/secrets/mininfer-keys.json

# Unlocks the operational surface (`/`, `/legacy`, `/v1/stats`, `/v1/plan`,
# `/v1/providers`, `/v1/local/*`). A browser can use it as the password of an
# HTTP Basic prompt; API clients send `Authorization: Bearer <token>`.
# MI_ADMIN_TOKEN=

# Requests per minute per tenant. 0 (default) disables limiting. The counter is
# in-process — a single replica behind it, or move it to Redis.
# MI_RATE_LIMIT_RPM=120

# Reject request bodies larger than this many bytes. 0 (default) disables it.
# MI_MAX_BODY_BYTES=1048576

# Comma-separated browser origins allowed to call the API cross-origin. Unset by
# default because the dashboard is served from this same origin.
# MI_CORS_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# Agents and the reserved arm. All optional — the defaults are sane.
#
# The three agents (`mi add-url`, `mi resolve --adjudicate`, `mi scout`) run on a
# free-first fallback chain and rotate across it, so one free tier is not
# exhausted while the rest idle. `MI_AGENT_MODELS` is the whole chain,
# `MI_AGENT_MODEL` pins a single arm in front of it, and `--agent-model` overrides
# both for one run. Needs the `[agents]` extra.
# MI_AGENT_MODEL=groq:qwen/qwen3.8-27b
# MI_AGENT_MODELS=openrouter/novita:inclusionai/ling-3.1-flash,openrouter/nvidia:nvidia/nemotron-3-super-120b-a12b:free,groq:qwen/qwen3.8-27b

# The reserved arm: tried only after the ranked chain is exhausted, so a request
# runs out of free arms but not out of an answer. Must be a callable deploy (its
# provider's key set). Overrides `last_resort` in config/policy.yaml.
# MI_LAST_RESORT=groq:qwen/qwen3.8-27b

# LLM tie-break for ambiguous task classification. Only fires when the cue scores
# are inconclusive; if it is unavailable the cue classifier stands, so it can only
# improve a guess. A free arm is fine.
# MI_INTENT_MODEL=openrouter/novita:inclusionai/ling-3.1-flash
