# Secrets and machine-local state. Never commit these.
.env
.env.local

# macOS Finder metadata.
.DS_Store

# Registry DB and the raw evidence lake (re-derivable; large).
*.db
*.db-journal
# Maintenance backups of the registry (e.g. mininfer.db.pre-featherless-<ts>).
# `*.db` does not match them: the name continues past the extension.
*.db.*
*.bak
raw/

# TLS bundle generated by scripts/make_ca_bundle.sh
.certs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# Virtualenv: machine-local and platform-specific, never commit. A full macOS
# `.venv` was once committed here and had to be purged from history.
.venv/
# `python -m build` output (wheel, sdist, and the setuptools staging tree)
build/
dist/

# Web dashboard: dependencies and build output are both derived.
web/node_modules/
web/dist/

# Local design scratch: a side-by-side logo comparison, not part of the docs
# site. Kept on disk for review, never published.
docs/logo-options.html
