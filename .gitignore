# Secrets and machine-local state. Never commit these.
.env
.env.local

# macOS Finder metadata.
.DS_Store

# Registry DB and the raw evidence lake (re-derivable; large).
*.db
*.db-journal
# Maintenance backups of the registry (e.g. mininfer.db.pre-featherless-<ts>).
# `*.db` does not match them: the name continues past the extension.
*.db.*
*.bak
raw/

# UI-agent performance reports: generated per run from a live server, useful for
# review but re-derivable, so they are kept on disk and out of history.
reports/

# Local TLS trust bundle. Machine-specific and must never be committed.
.certs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# Virtualenv: machine-local and platform-specific, never commit. A full macOS
# `.venv` was once committed here and had to be purged from history.
.venv/
# `python -m build` output (wheel, sdist, and the setuptools staging tree)
build/
dist/

# Web dashboard: dependencies and build output are both derived.
web/node_modules/
web/dist/

# Graphify knowledge graph: generated from the source by `/graphify .` and
# re-derivable at any time. Large (graph.json + graph.html) and never hand-edited.
graphify-out/

# Local design scratch: a side-by-side logo comparison, not part of the docs
# site. Kept on disk for review, never published.
docs/logo-options.html

# ---------------------------------------------------------------------------
# Non-performance evaluation artifacts.
#
# These are local QA/eval tooling and datasets: useful on this machine, but not
# part of a shipped change. The *performance* work is the shadow-trial role gate
# in mininfer/proxy.py, guarded by tests/test_shadow_trial_gate.py and measured by
# scripts/selection_eval.py — those stay tracked. Everything below is re-derivable
# and is ignored so it cannot ride along in a performance push.
# ---------------------------------------------------------------------------
scripts/ui_agent_test.py
scripts/ui_queries.json
scripts/decompose_bench.py
tests/data/
tests/test_decomposition_gold.py
docs/ui-test-plan.md
docs/decomposition-libraries.md
